# Copier dans functions/.env (à côté des paramètres Google Sheet existants).

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Adresse expéditeur (le domaine doit être vérifié dans Resend → SPF/DKIM)
RESEND_FROM=Gregory Prudhommeaux <gregory.prudhommeaux@franconetwork.app>

# URL publique de l'app (utilisée dans les CTA des emails)
APP_URL=https://franconetwork.app

# Sync parallèle nouveaux profils FN → LA MESA waitlist + Database Perso CONTACTER
# LA_MESA_IMPORT_URL=https://lamesasecreta.com/api/admin/import/franconetwork
# LA_MESA_IMPORT_SECRET=same-as-la-mesa-FRANCONETWORK_IMPORT_SECRET
# DATABASE_PERSO_BASE_URL=https://your-database-perso.vercel.app
# DATABASE_PERSO_API_TOKEN=…

# Pause temporaire digests / campagnes schedulées (ISO UTC). Vide = pas de pause.
# EMAIL_PAUSE_UNTIL=2026-10-09T20:00:00.000Z
