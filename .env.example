# Gemini (Vite) : copier les variables utiles vers .env.local — ne jamais commiter de vraie clé.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Firebase Web (Vite) ---
# À définir dans Vercel Environment Variables + .env.local.
# Ne jamais commiter de vraie clé ; restreindre la clé API par HTTP referrers dans Google Cloud.
VITE_FIREBASE_API_KEY="YOUR_RESTRICTED_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0229891518"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0229891518.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0229891518.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="594720424585"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-b6e23c83-eceb-4cf9-848f-8e11b8db6eb8"
# Optionnel si Analytics est utilisé.
VITE_FIREBASE_MEASUREMENT_ID=""

# URL publique du site (liens d’invitation → …/join). En build production, défaut : https://www.franconetwork.app
# Surcharge optionnelle (staging, preview) :
# VITE_PUBLIC_SITE_URL="https://www.franconetwork.app"

# GEMINI_API_KEY: alternative Node / hors Vite.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Formulaire Contact (Vercel uniquement, pas de préfixe VITE_) ---
# Resend : https://resend.com — créer une clé API, vérifier un domaine d’envoi si besoin.
RESEND_API_KEY="re_xxxxxxxx"
# Boîte qui reçoit les messages (jamais affichée sur le site ; à définir dans le tableau de bord Vercel).
CONTACT_TO_EMAIL="your-inbox@example.com"
# Expéditeur vu par le destinataire (domaine vérifié chez Resend, ex. Annuaire <contact@votredomaine.com>).
CONTACT_FROM_EMAIL="Annuaire Guadalajara <onboarding@resend.dev>"

# Optionnel : en local (npm run dev), pointer vers l’URL du déploiement qui expose /api/contact
# VITE_CONTACT_API_URL="https://franconetwork.app"
